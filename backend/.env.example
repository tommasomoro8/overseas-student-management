# In Docker queste variabili arrivano gia' dal docker-compose.yml.

# Server
PORT=3000
NODE_ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=mydatabase

# Autenticazione JWT
JWT_SECRET=cambia-questo-segreto-in-produzione
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# Upload file (PDF Learning Agreement / Transcript of Records)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Precarica utenti e istituzioni di test all'avvio (true/false)
SEED=true
